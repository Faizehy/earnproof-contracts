protocol-config persistent [sym:ConfigHistoryRing, u32:1] = {sym:category: [sym:PauseToggle], sym:config_version: u32:3, sym:ledger: u32:1000, sym:proposal_commitment: bytes:cd2662154e6d76b2b2b92e70c0cac3ccf534f9b74eb5b89819ec509083d00a50, sym:timestamp: u64:1000}
