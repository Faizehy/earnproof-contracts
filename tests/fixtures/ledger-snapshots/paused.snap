proof-registry topics=[sym:proof_registered] data={sym:epoch: u32:1, sym:proof_id_hash: bytes:3333333333333333333333333333333333333333333333333333333333333333}
protocol-config topics=[sym:paused] data={sym:paused: true}

[verdicts]
protocol-config.is_paused = true
protocol-config.is_schema_version_approved(1) = true
issuer-registry.is_active_address(issuer) = true
proof-registry.is_valid_proof(proof) = true
proof-registry.is_revoked(proof) = false
