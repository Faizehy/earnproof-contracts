# scenario: expired
# revision: 5
# reason: proof records now persist revoked_ledger and revocation emits proof_revoked
# body-digest: 4f1d18c1aae68f9a69dbe674ff3609bffe7083f04bea229dd09fea73794628d9

[ledger]
sequence = 1000
timestamp = 2001

[storage]
issuer-registry instance [sym:Admin] = addr:admin
issuer-registry instance [sym:ContractVersion] = u32:1
issuer-registry persistent [sym:AddressIssuer, addr:issuer] = bytes:1111111111111111111111111111111111111111111111111111111111111111
issuer-registry persistent [sym:Issuer, bytes:1111111111111111111111111111111111111111111111111111111111111111] = {sym:created_at: u64:1000, sym:issuer_address: addr:issuer, sym:issuer_id_hash: bytes:1111111111111111111111111111111111111111111111111111111111111111, sym:metadata_hash: bytes:2222222222222222222222222222222222222222222222222222222222222222, sym:status: [sym:Active], sym:updated_at: u64:1000}
proof-registry instance [sym:Admin] = addr:admin
proof-registry instance [sym:ContractVersion] = u32:1
proof-registry instance [sym:IssuerRegistry] = addr:issuer-registry
proof-registry instance [sym:ProtocolConfig] = addr:protocol-config
proof-registry persistent [sym:Proof, bytes:3333333333333333333333333333333333333333333333333333333333333333] = {sym:commitment_hash: bytes:4444444444444444444444444444444444444444444444444444444444444444, sym:created_at: u64:1000, sym:expires_at: u64:2000, sym:issuer_address: addr:issuer, sym:proof_id_hash: bytes:3333333333333333333333333333333333333333333333333333333333333333, sym:revoked_at: u64:0, sym:revoked_ledger: u32:0, sym:schema_version: u32:1, sym:status: [sym:Active]}
protocol-config instance [sym:Admin] = addr:admin
protocol-config instance [sym:ConfigVersion] = u32:2
protocol-config instance [sym:ContractVersion] = u32:1
protocol-config instance [sym:Paused] = false
protocol-config persistent [sym:SchemaVersion, u32:1] = true

[events]
protocol-config topics=[sym:initialized] data={sym:admin: addr:admin}
protocol-config topics=[sym:schema_approved] data={sym:version: u32:1}
issuer-registry topics=[sym:issuer_registered] data={sym:created_at: u64:1000, sym:issuer_address: addr:issuer, sym:issuer_id_hash: bytes:1111111111111111111111111111111111111111111111111111111111111111, sym:metadata_hash: bytes:2222222222222222222222222222222222222222222222222222222222222222}

[verdicts]
protocol-config.is_paused = false
protocol-config.is_schema_version_approved(1) = true
issuer-registry.is_active_address(issuer) = true
proof-registry.is_valid_proof(proof) = false
proof-registry.is_revoked(proof) = false
