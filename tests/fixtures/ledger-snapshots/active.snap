[ledger]
sequence = 1000
timestamp = 1000

[storage]
issuer-registry instance [sym:Admin] = addr:admin
issuer-registry instance [sym:ContractVersion] = u32:1
issuer-registry instance [sym:InstanceLiveUntil] = u32:501000
issuer-registry persistent [sym:AddressIssuer, addr:issuer] = bytes:1111111111111111111111111111111111111111111111111111111111111111
issuer-registry persistent [sym:AddressTtl, addr:issuer] = u32:501000
issuer-registry persistent [sym:Issuer, bytes:1111111111111111111111111111111111111111111111111111111111111111] = {sym:created_at: u64:1000, sym:issuer_address: addr:issuer, sym:issuer_id_hash: bytes:1111111111111111111111111111111111111111111111111111111111111111, sym:metadata_hash: bytes:2222222222222222222222222222222222222222222222222222222222222222, sym:provenance_commitment: bytes:6363636363636363636363636363636363636363636363636363636363636363, sym:reason_commitment: void, sym:status: [sym:Active], sym:updated_at: u64:1000}
issuer-registry persistent [sym:IssuerTtl, bytes:1111111111111111111111111111111111111111111111111111111111111111] = u32:501000
proof-registry instance [sym:Admin] = addr:admin
proof-registry instance [sym:ContractVersion] = u32:1
proof-registry instance [sym:IssuerRegistry] = addr:issuer-registry
proof-registry instance [sym:ProtocolConfig] = addr:protocol-config
proof-registry persistent [sym:Proof, bytes:3333333333333333333333333333333333333333333333333333333333333333] = {sym:commitment_hash: bytes:4444444444444444444444444444444444444444444444444444444444444444, sym:created_at: u64:1000, sym:expires_at: u64:2000, sym:issuer_address: addr:issuer, sym:proof_id_hash: bytes:3333333333333333333333333333333333333333333333333333333333333333, sym:proof_type: bytes:0101010101010101010101010101010101010101010101010101010101010101, sym:revoked_at: u64:0, sym:schema_version: u32:1, sym:status: [sym:Active]}
protocol-config instance [sym:Admin] = addr:admin
protocol-config instance [sym:ConfigVersion] = u32:3
protocol-config instance [sym:ContractVersion] = u32:1
protocol-config instance [sym:Paused] = false
protocol-config persistent [sym:ProofTypeApproved, bytes:0101010101010101010101010101010101010101010101010101010101010101] = true
protocol-config persistent [sym:SchemaVersion, u32:1] = true

[events]
protocol-config topics=[sym:initialized] data={sym:admin: addr:admin}
protocol-config topics=[sym:schema_approved] data={sym:version: u32:1}
protocol-config topics=[sym:proof_type_approved_event] data={sym:proof_type: bytes:0101010101010101010101010101010101010101010101010101010101010101}
issuer-registry topics=[sym:issuer_registered] data={sym:created_at: u64:1000, sym:issuer_address: addr:issuer, sym:issuer_id_hash: bytes:1111111111111111111111111111111111111111111111111111111111111111, sym:metadata_hash: bytes:2222222222222222222222222222222222222222222222222222222222222222, sym:provenance_commitment: bytes:6363636363636363636363636363636363636363636363636363636363636363}

[verdicts]
